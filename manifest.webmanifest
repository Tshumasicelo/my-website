{
  "name": "ASPECTS — Money & Micro-Goals",
  "short_name": "ASPECTS",
  "description": "A private, offline-first tracker for your money and your micro-goals. Budgets, savings goals, streaks and focus sessions — all stored on your own device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#08090d",
  "theme_color": "#08090d",
  "lang": "en-ZA",
  "dir": "ltr",
  "categories": ["finance", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png",          "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png",          "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "short_name": "Expense",
      "description": "Record money going out",
      "url": "./?go=expense",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Add income",
      "short_name": "Income",
      "description": "Record money coming in",
      "url": "./?go=income",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "New task",
      "short_name": "Task",
      "description": "Add a micro-task",
      "url": "./?go=task",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
