<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- The Drive Mode atmosphere, painted straight to the canvas. -->
    <com.aspects.tvlauncher.DriveBackgroundView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The focused app's artwork, stretched from a 64x36 thumbnail so the
         upscale itself does the blurring. -->
    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Keeps the clock and rows readable over whatever the backdrop happens
         to be, and carries the app's dominant colour. -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <ScrollView
        android:id="@+id/scroller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingTop="@dimen/overscan_v"
            android:paddingBottom="48dp">

            <!-- Shown only while some other app is the home screen. -->
            <LinearLayout
                android:id="@+id/homePrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/overscan_h"
                android:layout_marginEnd="@dimen/overscan_h"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home" />

                <TextView
                    android:id="@+id/homePromptText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/home_prompt"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- ============ HEADER / CLUSTER ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingStart="@dimen/overscan_h"
                android:paddingEnd="@dimen/overscan_h">

                <com.aspects.tvlauncher.ClockGaugeView
                    android:id="@+id/clockGauge"
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="#FFFFFF"
                        android:textSize="56sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:letterSpacing="0.06"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cluster"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <com.aspects.tvlauncher.GaugeView
                            android:id="@+id/gaugeRam"
                            android:layout_width="104dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="14dp" />

                        <com.aspects.tvlauncher.GaugeView
                            android:id="@+id/gaugeDisk"
                            android:layout_width="104dp"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="6dp"
                        android:letterSpacing="0.05"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ ROWS ============ -->
            <TextView android:id="@+id/titleFav" style="@style/RowTitle" android:text="@string/row_favourites" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rowFav" style="@style/AppRow" />

            <TextView android:id="@+id/titleTv" style="@style/RowTitle" android:text="@string/row_tv_apps" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rowTv" style="@style/AppRow" />

            <TextView android:id="@+id/titleAll" style="@style/RowTitle" android:text="@string/row_all_apps" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rowAll" style="@style/AppRow" />

            <TextView android:id="@+id/titleSys" style="@style/RowTitle" android:text="@string/row_system" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rowSys" style="@style/AppRow" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/overscan_h"
                android:paddingTop="40dp"
                android:paddingEnd="@dimen/overscan_h"
                android:text="@string/no_apps"
                android:textColor="#8B93A2"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Headlight wash for the ignition sequence. -->
    <View
        android:id="@+id/bloom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="gone" />

    <!-- Parked mode: everything fades but the clock. -->
    <FrameLayout
        android:id="@+id/parked"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <TextView
            android:id="@+id/parkedClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha="0.55"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="96sp"
            android:textStyle="bold" />
    </FrameLayout>
</FrameLayout>
