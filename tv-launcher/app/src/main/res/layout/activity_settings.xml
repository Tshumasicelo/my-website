<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <View
        android:id="@+id/glow"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="top" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/overscan_h"
            android:paddingTop="@dimen/overscan_v"
            android:paddingEnd="@dimen/overscan_h"
            android:paddingBottom="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <!-- Rows are built in code: it keeps the toggle/accent logic in one
                 place instead of spread across XML ids. -->
            <LinearLayout
                android:id="@+id/container"
                android:layout_width="760dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/about"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/faint"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
